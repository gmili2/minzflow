// MizanFlow — ERP multi-entreprises (MariaDB 11.4, hébergement Namecheap)
// Montants en centimes (Int) : jamais de float pour l'argent. Quantités en Decimal(12,3).
// Toutes les données métier portent tenantId : chaque requête de l'API filtre sur l'entreprise de l'utilisateur.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  COMPTABLE
  COMMERCIAL
  LECTURE
}

enum DocType {
  DEVIS
  BL
  FACTURE
  AVOIR
  BC
}

enum PayMethod {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  EFFET
}

enum MoveKind {
  IN
  OUT
  ADJUST
}

enum CashType {
  IN
  OUT
}

model Tenant {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(60)
  logoUrl      String?  @db.VarChar(255)
  primaryColor String   @default("#047857") @db.VarChar(9)
  legalForm    String?  @db.VarChar(40)
  ice          String?  @db.VarChar(30)
  rc           String?  @db.VarChar(30)
  ifiscal      String?  @db.VarChar(30)
  patente      String?  @db.VarChar(30)
  cnss         String?  @db.VarChar(30)
  capital      String?  @db.VarChar(40)
  address      String?  @db.VarChar(255)
  city         String?  @db.VarChar(80)
  phone        String?  @db.VarChar(40)
  email        String?  @db.VarChar(254)
  website      String?  @db.VarChar(160)
  bankName     String?  @db.VarChar(80)
  rib          String?  @db.VarChar(40)
  tvaDefault   Int      @default(20)
  paymentDays  Int      @default(30)
  quoteDays    Int      @default(30)
  footer       String?  @db.Text
  openingCash  Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users      User[]
  clients    Client[]
  suppliers  Supplier[]
  products   Product[]
  documents  Document[]
  payments   Payment[]
  expenses   Expense[]
  cashOps    CashOp[]
  movements  StockMovement[]
  activities Activity[]
  counters   Counter[]

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(120)
  role         Role
  active       Boolean   @default(true)
  avatarUrl    String?   @db.VarChar(255)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String    @db.VarChar(64)
  tokenHash    String    @unique @db.VarChar(64)
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Counter {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String @db.VarChar(40)
  value    Int    @default(0)

  @@id([tenantId, key])
  @@map("counters")
}

model Client {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String     @db.VarChar(160)
  ice       String?    @db.VarChar(30)
  contact   String?    @db.VarChar(120)
  city      String?    @db.VarChar(80)
  address   String?    @db.VarChar(255)
  email     String?    @db.VarChar(254)
  phone     String?    @db.VarChar(40)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]

  @@index([tenantId, name])
  @@map("clients")
}

model Supplier {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String     @db.VarChar(160)
  category  String?    @db.VarChar(80)
  ice       String?    @db.VarChar(30)
  contact   String?    @db.VarChar(120)
  city      String?    @db.VarChar(80)
  address   String?    @db.VarChar(255)
  email     String?    @db.VarChar(254)
  phone     String?    @db.VarChar(40)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
  expenses  Expense[]

  @@index([tenantId, name])
  @@map("suppliers")
}

model Product {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ref            String          @db.VarChar(40)
  name           String          @db.VarChar(200)
  category       String?         @db.VarChar(80)
  unit           String          @default("u") @db.VarChar(12)
  isService      Boolean         @default(false)
  stock          Decimal         @default(0) @db.Decimal(12, 3)
  alertThreshold Decimal         @default(0) @db.Decimal(12, 3)
  purchasePrice  Int             @default(0)
  salePrice      Int             @default(0)
  tvaRate        Int             @default(20)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lines          DocumentLine[]
  movements      StockMovement[]

  @@unique([tenantId, ref])
  @@index([tenantId, name])
  @@map("products")
}

model Document {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         DocType
  number       String         @db.VarChar(30)
  status       String         @db.VarChar(20)
  date         DateTime       @db.Date
  dueDate      DateTime?      @db.Date
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id])
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  subject      String?        @db.VarChar(200)
  notes        String?        @db.Text
  totalHT      Int            @default(0)
  totalTVA     Int            @default(0)
  totalTTC     Int            @default(0)
  paidAmount   Int            @default(0)
  stockApplied Boolean        @default(false)
  sourceId     String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lines        DocumentLine[]
  payments     Payment[]

  @@unique([tenantId, type, number])
  @@index([tenantId, type, date])
  @@index([tenantId, clientId])
  @@index([tenantId, supplierId])
  @@index([sourceId])
  @@map("documents")
}

model DocumentLine {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  designation String   @db.VarChar(255)
  qty         Decimal  @db.Decimal(12, 3)
  unitPrice   Int
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  tvaRate     Int
  totalHT     Int
  position    Int      @default(0)

  @@index([documentId])
  @@index([productId])
  @@map("document_lines")
}

model Payment {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  amount     Int
  method     PayMethod
  reference  String?   @db.VarChar(80)
  note       String?   @db.VarChar(255)
  createdAt  DateTime  @default(now())

  @@index([tenantId, date])
  @@index([documentId])
  @@map("payments")
}

model Expense {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  label      String     @db.VarChar(200)
  category   String     @db.VarChar(60)
  amount     Int
  tvaAmount  Int        @default(0)
  supplierId String?
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  method     PayMethod  @default(ESPECES)
  reference  String?    @db.VarChar(80)
  createdAt  DateTime   @default(now())

  @@index([tenantId, date])
  @@map("expenses")
}

model CashOp {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  label     String    @db.VarChar(200)
  type      CashType
  amount    Int
  method    PayMethod @default(ESPECES)
  createdAt DateTime  @default(now())

  @@index([tenantId, date])
  @@map("cash_ops")
}

model StockMovement {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  kind       MoveKind
  qty        Decimal  @db.Decimal(12, 3)
  reason     String   @db.VarChar(200)
  documentId String?
  userId     String?

  @@index([tenantId, date])
  @@index([productId, date])
  @@map("stock_movements")
}

model Activity {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  kind      String   @db.VarChar(20)
  title     String   @db.VarChar(200)
  sub       String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("activities")
}
